{
  "name": "stupid-territorialism",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jogo de cercar quarteirões com bandeiras, num mapa de ruas.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sim": "vitest run --config vitest.sim.config.ts tournament",
    "evolve": "vitest run --config vitest.sim.config.ts evolve"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.2"
  }
}
